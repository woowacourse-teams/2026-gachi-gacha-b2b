B2B_API_BASE_URL=/api/v1
B2B_AI_API_BASE_URL=/api/b2b-ai
B2B_USE_MSW=true
B2B_BACKEND_ORIGIN=http://127.0.0.1:8080

# 아래 값은 브라우저 번들에 포함되지 않고 BFF 프로세스에서만 읽습니다.
B2B_BACKEND_BASE_URL=http://127.0.0.1:8080/api/v1
# 제공자 API 키는 화면에서 사용자가 입력하며 파일이나 서버 환경변수에 저장하지 않습니다.
OPENAI_MODEL=gpt-4o-mini-2024-07-18
GEMINI_MODEL=gemini-3.1-flash-lite
AI_IMAGE_HOST_ALLOWLIST=
AI_HOST=127.0.0.1
AI_PORT=8787
AI_RATE_LIMIT_PER_MINUTE=20
